CLIENT

from picarx import Picarx
import socket
import time

# --- CONFIGURAZIONE RETE ---
SERVER_IP = '192.168.2.119'
PORT = 9999

# --- CONFIGURAZIONE SENSORI E MOVIMENTO ---
px = Picarx()
SOGLIA_OSTACOLO = 25  # Distanza in cm per attivare l'emergenza
VELOCITA_BASE = 70
VELOCITA_EVASIONE = 50 
COEFF_STERZATA = 0.4
TEMPO_IMPULSO = 0.15
TRIM_STERZO = 0  # Se il rover va verso destra, metti un numero negativo. Se va a sinistra, positivo. (Prova valori tra -5 e 5)
# --- INIZIALIZZAZIONE SOCKET ---
client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

def connetti():
    while True:
        try:
            print(f"Tentativo di connessione a {SERVER_IP}:{PORT}...")
            client_socket.connect((SERVER_IP, PORT))
            print("Connesso! Radar + Sensore Ostacoli Attivo.")
            client_socket.settimeout(1.0)
            break
        except Exception as e:
            print(f"Server non trovato, riprovo... ({e})")
            time.sleep(2)

def esegui_evasione(tipo_comando):
    """Blocca il rover e lo allontana dall'ostacolo"""
    print(f"!!! OSTACOLO RILEVATO durante {tipo_comando} !!!")
    
    # 1. Fermata immediata
    px.forward(0)
    time.sleep(0.1)

    if tipo_comando in ["W", "W_MAX", "WD", "WA"]:
        # Manovra Standard: Indietro dritto per ~40cm
        px.set_dir_servo_angle(TRIM_STERZO)
        px.backward(VELOCITA_EVASIONE)
        time.sleep(1.2) # Tempo stimato per 40cm
        
    elif tipo_comando == "A":
        # Se stava andando a SX: Indietro girando a DX per ~30cm
        # Questo allontana il muso dall'ostacolo a sinistra
        px.set_dir_servo_angle(-35) 
        px.backward(VELOCITA_EVASIONE)
        time.sleep(0.9) # Tempo stimato per 30cm
        
    elif tipo_comando == "D":
        # Se stava andando a DX: Indietro girando a SX per ~30cm
        px.set_dir_servo_angle(35)
        px.backward(VELOCITA_EVASIONE)
        time.sleep(0.9)

    # Ripristina assetto e ferma
    px.forward(0)
    px.set_dir_servo_angle(TRIM_STERZO)
    print("Manovra completata. Riprendo ascolto radar.")

def gestisci_motori(comando, v_mult):
    """Gestione normale dei motori"""
    v_calcolata = int(VELOCITA_BASE * float(v_mult))
    
    if comando == "STOP":
        px.forward(0)
        px.set_dir_servo_angle(TRIM_STERZO)
    elif comando in ["W", "W_MAX"]:
        px.set_dir_servo_angle(TRIM_STERZO)
        px.forward(v_calcolata)
    elif comando == "S":
        px.set_dir_servo_angle(TRIM_STERZO)
        px.backward(v_calcolata)
    elif comando == "D":
        px.set_dir_servo_angle(-35)
        px.forward(int(v_calcolata * COEFF_STERZATA))
        time.sleep(TEMPO_IMPULSO)
        px.set_dir_servo_angle(TRIM_STERZO)
        px.forward(0)
    elif comando == "A":
        px.set_dir_servo_angle(35)
        px.forward(int(v_calcolata * COEFF_STERZATA))
        time.sleep(TEMPO_IMPULSO)
        px.set_dir_servo_angle(TRIM_STERZO)
        px.forward(0)
    elif comando == "WD":
        px.set_dir_servo_angle(-20)
        px.forward(int(v_calcolata * 0.7))
    elif comando == "WA":
        px.set_dir_servo_angle(20)
        px.forward(int(v_calcolata * 0.7))

def main():
    connetti()
    buffer = ""
    
    try:
        while True:
            # --- CONTROLLO OSTACOLO (REALE) ---
            distanza = px.ultrasonic.read()
            
            # Se la distanza è critica, controlliamo se stiamo andando avanti
            # (Non deve attivarsi se stiamo andando indietro 'S')
            
            try:
                raw_data = client_socket.recv(1024)
                if not raw_data: break
                buffer += raw_data.decode('utf-8')
                
                if '\n' in buffer:
                    linee = buffer.split('\n')
                    ultimo_comando_raw = linee[-2]
                    buffer = linee[-1]
                    
                    parti = ultimo_comando_raw.strip().split(',')
                    if len(parti) >= 2:
                        cmd = parti[0]
                        v_m = parti[1]

                        # LOGICA DI SICUREZZA:
                        # Se c'è un ostacolo e il comando è di avanzamento...
                        if distanza > 0 and distanza < SOGLIA_OSTACOLO and cmd not in ["S", "STOP"]:
                            esegui_evasione(cmd)
                            # Puliamo il buffer per non eseguire comandi vecchi post-manovra
                            buffer = "" 
                        else:
                            gestisci_motori(cmd, v_m)

            except socket.timeout:
                px.forward(0)
            except Exception as e:
                print(f"Errore: {e}")
                break

    except KeyboardInterrupt:
        print("\nGara terminata.")
    finally:
        px.forward(0)
        px.set_dir_servo_angle(TRIM_STERZO)
        client_socket.close()

if __name__ == "__main__":
    main()


SERVER


import cv2
import cv2.aruco as aruco
import numpy as np
import socket
import math
import time  # Aggiunto per gestire il timer del salto

# =================================================================
# --- VARIABILI DI GARA (MODIFICABILI) ---
# =================================================================

# RETE
HOST = '0.0.0.0'
PORT = 9999            

# MARKER E DISTANZE
LATO_MARKER_CM = 19.0      # Dimensione del marker stampato
DISTANZA_MIN = 75          # Distanza minima di aggancio (cm)
DISTANZA_MAX = 175         # Distanza massima di aggancio normale (cm)

# PARAMETRI SALTO PONTE (OSTACOLI SOSPESI)
DISTANZA_PONTE_MIN = 230   # Da quanti cm inizia a riconoscere l'intenzione di saltare
DISTANZA_PONTE_MAX = 270   # Fino a quanti cm riconosce l'intenzione
TEMPO_SALTO_PONTE = 2.0    # Quanti secondi il rover andrà dritto "alla cieca"

# LAYOUT RADAR (RAGGI E ANGOLI)
R1 = 80      # Raggio centrale (Dritto)
R2 = 150     # Raggio intermedio (Primo arco)
R3 = 200     # Raggio esterno (Secondo arco - Indietro)
R_MAX = 2000 # Raggio infinito per i limiti visivi
ANG_C = 35   # Ampiezza dell'angolo del cono centrale (Destra/Sinistra)

# =================================================================
# --- CALIBRAZIONE WEBCAM ---
# =================================================================
CAMERA_MATRIX = np.array([
    [558.80333994,   0.        , 310.70361399],
    [  0.        , 550.123456  , 240.123456  ],
    [  0.        ,   0.        ,   1.        ]
], dtype=np.float32)

DIST_COEFFS = np.array([
    [-0.12490098,  0.27240783, -0.00234196, -0.00097381, -0.79204814]
], dtype=np.float32)

# =================================================================


# --- INIZIALIZZAZIONE VISIONE E ARUCO ---
cap = cv2.VideoCapture(0)
# Forza la risoluzione a 640x480 per farla coincidere con la calibrazione
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

aruco_dict = aruco.getPredefinedDictionary(aruco.DICT_6X6_250) 
parameters = aruco.DetectorParameters()
detector = aruco.ArucoDetector(aruco_dict, parameters)

obj_points = np.array([
    [-LATO_MARKER_CM/2,  LATO_MARKER_CM/2, 0],
    [ LATO_MARKER_CM/2,  LATO_MARKER_CM/2, 0],
    [ LATO_MARKER_CM/2, -LATO_MARKER_CM/2, 0],
    [-LATO_MARKER_CM/2, -LATO_MARKER_CM/2, 0]
], dtype=np.float32)

# Angoli OpenCV derivati dalle variabili di gara
A_T_LEFT  = 270 - ANG_C  
A_T_RIGHT = 270 + ANG_C  
A_B_LEFT  = 90 + ANG_C   
A_B_RIGHT = 90 - ANG_C   

ZONE_NAMES = ['DRITTO', 'V 100', 'STOP', 'INDIETRO', 'AV-SX', 'SX', 'AV-DX', 'DX']
ZONE_CMDS  = ['W',      'W_MAX', 'STOP', 'S',        'WA',    'A',  'WD',    'D']
ZONE_COLORS= [(0,255,0),(255,255,255),(0,0,255),(0,165,255),(0,255,150),(255,0,255),(150,255,0),(255,255,0)]

def create_wedge(h, w, cx, cy, start_ang, end_ang, r_min, r_max):
    mask = np.zeros((h, w), dtype=np.uint8)
    cv2.ellipse(mask, (cx, cy), (r_max, r_max), 0, start_ang, end_ang, 255, -1)
    if r_min > 0:
        cv2.circle(mask, (cx, cy), r_min, 0, -1)
    return mask

def get_hud_masks(h, w, cx, cy):
    z_dritto = np.zeros((h, w), dtype=np.uint8)
    cv2.circle(z_dritto, (cx, cy), R1, 255, -1)
    
    z_v100 = create_wedge(h, w, cx, cy, A_T_LEFT, A_T_RIGHT, R1, R_MAX)
    
    z_stop_bottom = create_wedge(h, w, cx, cy, A_B_RIGHT, A_B_LEFT, R1, R_MAX)
    z_stop_arc_sx = create_wedge(h, w, cx, cy, 180, A_T_LEFT, R2, R3)
    z_stop_arc_dx = create_wedge(h, w, cx, cy, A_T_RIGHT, 360, R2, R3)
    z_stop_ind_sx = create_wedge(h, w, cx, cy, A_B_LEFT, 180, R1, R3)
    z_stop_ind_dx = create_wedge(h, w, cx, cy, 0, A_B_RIGHT, R1, R3)
    
    z_stop = cv2.bitwise_or(z_stop_bottom, 
             cv2.bitwise_or(z_stop_arc_sx, 
             cv2.bitwise_or(z_stop_arc_dx, 
             cv2.bitwise_or(z_stop_ind_sx, z_stop_ind_dx))))
    
    z_ind_sx = create_wedge(h, w, cx, cy, A_B_LEFT, 180, R3, R_MAX)
    z_ind_dx = create_wedge(h, w, cx, cy, 0, A_B_RIGHT, R3, R_MAX)
    z_indietro = cv2.bitwise_or(z_ind_sx, z_ind_dx)
    
    z_av_sx = create_wedge(h, w, cx, cy, 180, A_T_LEFT, R1, R2)
    z_sx    = create_wedge(h, w, cx, cy, 180, A_T_LEFT, R3, R_MAX)
    
    z_av_dx = create_wedge(h, w, cx, cy, A_T_RIGHT, 360, R1, R2)
    z_dx    = create_wedge(h, w, cx, cy, A_T_RIGHT, 360, R3, R_MAX)
    
    return [z_dritto, z_v100, z_stop, z_indietro, z_av_sx, z_sx, z_av_dx, z_dx]

def draw_hud_lines(frame, cx, cy, w):
    col_base = (255, 200, 0); col_stop = (0, 0, 255); col_ind = (0, 165, 255)
    thick = 2
    
    cv2.circle(frame, (cx, cy), R1, col_base, thick)
    for ang in [A_T_LEFT, A_T_RIGHT, A_B_LEFT, A_B_RIGHT]:
        rad = math.radians(ang)
        x1, y1 = int(cx + R1 * math.cos(rad)), int(cy + R1 * math.sin(rad))
        x2, y2 = int(cx + 2000 * math.cos(rad)), int(cy + 2000 * math.sin(rad))
        cv2.line(frame, (x1, y1), (x2, y2), col_base, thick)
        
    cv2.line(frame, (cx - R1, cy), (cx - 2000, cy), col_base, thick)
    cv2.line(frame, (cx + R1, cy), (cx + 2000, cy), col_base, thick)
    
    cv2.ellipse(frame, (cx, cy), (R2, R2), 0, 180, A_T_LEFT, col_stop, thick)
    cv2.ellipse(frame, (cx, cy), (R3, R3), 0, 180, A_T_LEFT, col_stop, thick)
    cv2.ellipse(frame, (cx, cy), (R2, R2), 0, A_T_RIGHT, 360, col_stop, thick)
    cv2.ellipse(frame, (cx, cy), (R3, R3), 0, A_T_RIGHT, 360, col_stop, thick)

    cv2.ellipse(frame, (cx, cy), (R2, R2), 0, A_B_LEFT, 180, col_stop, thick) 
    cv2.ellipse(frame, (cx, cy), (R3, R3), 0, A_B_LEFT, 180, col_stop, thick) 
    cv2.ellipse(frame, (cx, cy), (R2, R2), 0, 0, A_B_RIGHT, col_stop, thick)  
    cv2.ellipse(frame, (cx, cy), (R3, R3), 0, 0, A_B_RIGHT, col_stop, thick)  

    f = cv2.FONT_HERSHEY_SIMPLEX
    cv2.putText(frame, "DRITTO", (cx-35, cy+5), f, 0.6, (255,255,255), 2)
    cv2.putText(frame, "V 100", (cx-30, cy-R1-40), f, 0.6, (255,255,255), 2)
    cv2.putText(frame, "STOP", (cx-25, cy+R1+60), f, 0.6, col_stop, 2) 
    
    cv2.putText(frame, "AV-SX", (cx-120, cy-30), f, 0.5, (255,255,255), 2)
    cv2.putText(frame, "STOP", (cx-180, cy-30), f, 0.5, col_stop, 2)
    cv2.putText(frame, "SX", (cx-230, cy-30), f, 0.7, (255,255,255), 2)
    
    cv2.putText(frame, "AV-DX", (cx+70, cy-30), f, 0.5, (255,255,255), 2)
    cv2.putText(frame, "STOP", (cx+160, cy-30), f, 0.5, col_stop, 2)
    cv2.putText(frame, "DX", (cx+220, cy-30), f, 0.7, (255,255,255), 2)
    
    cv2.putText(frame, "STOP", (cx-140, cy+80), f, 0.5, col_stop, 2)
    cv2.putText(frame, "STOP", (cx+90, cy+80), f, 0.5, col_stop, 2)
    
    cv2.putText(frame, "INDIETRO", (cx-240, cy+140), f, 0.6, col_ind, 2)
    cv2.putText(frame, "INDIETRO", (cx+140, cy+140), f, 0.6, col_ind, 2)

hud_masks = None

# --- AVVIO SERVER ---
server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    server_socket.bind((HOST, PORT))
    server_socket.listen(1)
    server_socket.settimeout(0.05) 
    print("Server Radar Avviato! In attesa del Rover...")
except Exception as e:
    print(f"Errore Server: {e}"); exit()

client_socket = None

# Variabili di stato per il Salto del Ponte
salto_in_corso = False
tempo_inizio_salto = 0

try:
    while True:
        ret, frame = cap.read()
        if not ret: break
        
        # Facoltativo: se l'immagine ha una fastidiosa deformazione "a barile", scommenta la riga sotto:
        # frame = cv2.undistort(frame, CAMERA_MATRIX, DIST_COEFFS)
        
        clean_frame = frame.copy()
        display_frame = frame.copy()

        h, w = display_frame.shape[:2]
        cx, cy = w // 2, h // 2
        
        if client_socket is None:
            try:
                client_socket, addr = server_socket.accept()
                client_socket.settimeout(None)
            except: pass

        if hud_masks is None or hud_masks[0].shape != (h, w):
            hud_masks = get_hud_masks(h, w, cx, cy)

        gray = cv2.cvtColor(clean_frame, cv2.COLOR_BGR2GRAY)
        corners, ids, rejected = detector.detectMarkers(gray)
        
        cmd = 'STOP'; v_mult = 0.0; distanza_cm = 0.0
        stato_testo = "NESSUN MARKER"
        colore_scelto = (0, 0, 255)
        
        # --- GESTIONE TIMER SALTO PONTE ---
        if salto_in_corso:
            tempo_trascorso = time.time() - tempo_inizio_salto
            if tempo_trascorso < TEMPO_SALTO_PONTE:
                # Forza il rover ad andare dritto al 100%
                cmd = 'W'
                v_mult = 1.0
                stato_testo = f"SALTO PONTE! ({TEMPO_SALTO_PONTE - tempo_trascorso:.1f}s)"
                colore_scelto = (255, 255, 255)
            else:
                salto_in_corso = False # Fine del salto
                
        # --- LOGICA NORMALE (SE NON STIAMO SALTANDO IL PONTE) ---
        if not salto_in_corso:
            if ids is not None and 0 in ids:
                idx = np.where(ids == 0)[0][0]
                ang_marker = corners[idx]
                
                # QUI USIAMO LA TUA MATRICE DI CALIBRAZIONE VERA!
                success, rvec, tvec = cv2.solvePnP(obj_points, ang_marker[0], CAMERA_MATRIX, DIST_COEFFS)
                
                if success:
                    distanza_cm = tvec[2][0] 
                    
                    # 1. CONTROLLO TRIGGER SALTO PONTE
                    if DISTANZA_PONTE_MIN <= distanza_cm <= DISTANZA_PONTE_MAX:
                        salto_in_corso = True
                        tempo_inizio_salto = time.time()
                        cmd = 'W'; v_mult = 1.0
                        stato_testo = "AVVIO SALTO PONTE!"
                        colore_scelto = (255, 255, 255)
                        
                    # 2. CONTROLLO RANGE NORMALE
                    elif DISTANZA_MIN <= distanza_cm <= DISTANZA_MAX:
                        mask_aruco = np.zeros((h, w), dtype=np.uint8)
                        cv2.fillPoly(mask_aruco, [ang_marker.astype(np.int32)], 255)
                        
                        zone_intersezioni = [cv2.countNonZero(cv2.bitwise_and(mask_aruco, m)) for m in hud_masks]
                        area_totale = sum(zone_intersezioni)
                        
                        if area_totale > 300:
                            zone_idx = np.argmax(zone_intersezioni)
                            stato_testo = ZONE_NAMES[zone_idx]
                            colore_scelto = ZONE_COLORS[zone_idx]
                            
                            if ZONE_CMDS[zone_idx] == 'W_MAX':
                                cmd = 'W'; v_mult = 1.0
                            elif ZONE_CMDS[zone_idx] == 'S':
                                cmd = 'S'; v_mult = 0.5
                            elif ZONE_CMDS[zone_idx] == 'STOP':
                                cmd = 'STOP'; v_mult = 0.0
                            else:
                                cmd = ZONE_CMDS[zone_idx]
                                if distanza_cm < 100: v_mult = 0.4
                                elif 100 <= distanza_cm <= 140: v_mult = 0.7
                                else: v_mult = 1.0
                    else:
                        stato_testo = "FUORI RANGE"
                        cmd = 'STOP'; v_mult = 0.0

                cv2.polylines(display_frame, [ang_marker.astype(np.int32)], True, colore_scelto, 3)

        draw_hud_lines(display_frame, cx, cy, w)
        
        cv2.putText(display_frame, f"AZIONE: {stato_testo}", (20, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.8, colore_scelto, 2)
        cv2.putText(display_frame, f"VELOCITA: {int(v_mult*100)}%", (20, 70), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
        cv2.putText(display_frame, f"DISTANZA: {int(distanza_cm)}cm", (w-200, 40), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
        
        cv2.imshow('Radar Pilot DJI Neo', display_frame)
        
        if client_socket:
            try: 
                client_socket.sendall(f"{cmd},{v_mult},{int(distanza_cm)}\n".encode())
            except: 
                client_socket = None
            
        if cv2.waitKey(1) & 0xFF == ord('q'): break

finally:
    if cap: cap.release()
    if cv2: cv2.destroyAllWindows()
    if client_socket: client_socket.close()
    if server_socket: server_socket.close()


