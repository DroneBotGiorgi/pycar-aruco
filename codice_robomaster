import socket
import sys
import time
import robomaster
from robomaster import robot

# ==========================================================
#              PARAMETRI MODIFICABILI
# ==========================================================
SERVER_IP = '192.168.2.119'  # Inserite l'IP del PC Server
SERVER_PORT = 9999
USA_SENSORE_TOF = False     # True = Attivo, False = Disattivo
SOGLIA_OSTACOLO_MM = 250    # Distanza di blocco (25cm)
# ==========================================================

distanza_rilevata = 9999

def on_detect_distance(dist_info):
    global distanza_rilevata
    # Prendiamo il valore minimo tra i sensori attivi (escludendo gli 0)
    valid_distances = [d for d in dist_info if d > 0]
    if valid_distances:
        distanza_rilevata = min(valid_distances)

def start_client():
    global distanza_rilevata
    ep_robot = robot.Robot()
    
    try:
        print("Inizializzazione RoboMaster...")
        if not ep_robot.initialize(conn_type="rndis"):
            print("❌ Errore: Robot non trovato su USB.")
            return

        # Impostiamo modalità FREE per sbloccare i moduli
        ep_robot.set_robot_mode(mode=robot.FREE)

        # Configurazione Sensore ToF
        if USA_SENSORE_TOF:
            print("📡 Sensore ToF: ATTIVATO")
            tof_sensor = ep_robot.sensor
            tof_sensor.sub_distance(freq=10, callback=on_detect_distance)
        else:
            print("⚪ Sensore ToF: DISATTIVATO (Ignorato)")

        # Connessione al Server PC
        print(f"Connessione al server {SERVER_IP}...")
        client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        client_socket.settimeout(5.0)
        
        try:
            client_socket.connect((SERVER_IP, SERVER_PORT))
        except Exception as e:
            print(f"❌ Impossibile connettersi al Server PC: {e}")
            return

        print("✅ SISTEMA PRONTO. In ascolto dei comandi...")

        while True:
            data = client_socket.recv(1024).decode().strip()
            if not data: break
            
            # Formato atteso: "COMANDO,VELOCITA,DISTANZA_DRONE"
            try:
                parts = data.split(',')
                cmd = parts[0]
                v_mult = float(parts[1])
                
                # --- LOGICA DI SICUREZZA ---
                # Se il sensore è attivo e vede un ostacolo vicino, forziamo lo STOP
                # solo se il comando è di andare avanti (W, WA, WD o W_MAX)
                if USA_SENSORE_TOF and distanza_rilevata < SOGLIA_OSTACOLO_MM:
                    if cmd in ['W', 'WA', 'WD', 'W_MAX']:
                        print(f"⚠️ OSTACOLO A {distanza_rilevata}mm! BLOCCO AVANZAMENTO.")
                        cmd = 'STOP'
                        v_mult = 0.0

                # Esecuzione comandi
                speed = 0.5 * v_mult
                if cmd == 'W':        ep_robot.chassis.drive_speed(x=speed, y=0, z=0)
                elif cmd == 'W_MAX':  ep_robot.chassis.drive_speed(x=0.8, y=0, z=0)
                elif cmd == 'S':      ep_robot.chassis.drive_speed(x=-speed, y=0, z=0)
                elif cmd == 'A':      ep_robot.chassis.drive_speed(x=0, y=0, z=-speed*40)
                elif cmd == 'D':      ep_robot.chassis.drive_speed(x=0, y=0, z=speed*40)
                elif cmd == 'WA':     ep_robot.chassis.drive_speed(x=speed, y=0, z=-speed*30)
                elif cmd == 'WD':     ep_robot.chassis.drive_speed(x=speed, y=0, z=speed*30)
                else:                 ep_robot.chassis.drive_speed(x=0, y=0, z=0)

            except Exception as e:
                print(f"Errore parsing: {e}")

    except KeyboardInterrupt:
        print("\nArresto manuale...")
    except Exception as e:
        print(f"\n❌ Errore Critico: {e}")
    finally:
        if USA_SENSORE_TOF:
            try: tof_sensor.unsub_distance()
            except: pass
        client_socket.close()
        ep_robot.close()
        print("Connessione chiusa.")

if __name__ == "__main__":
    start_client()



