{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sim | Vision Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "args": [
        "--host",
        "${input:serverHost}",
        "--port",
        "${input:serverPort}",
        "--camera",
        "${input:cameraIndex}",
        "--marker-id",
        "${input:markerId}",
        "--mode",
        "${input:simMode}",
        "--window-title",
        "Vision Server (Sim)"
      ]
    },
    {
      "name": "Sim | Visual Rover Client",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/simulator_client.py",
      "console": "integratedTerminal",
      "args": [
        "--host",
        "${input:clientHost}",
        "--port",
        "${input:serverPort}"
      ]
    },
    {
      "name": "Sim | Vision Server (RoboMaster Fake API)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "args": [
        "--transport",
        "robomaster-fake",
        "--camera",
        "${input:cameraIndex}",
        "--marker-id",
        "${input:markerId}",
        "--mode",
        "${input:robomasterMode}",
        "--robomaster-speed",
        "${input:robomasterSpeed}",
        "--command-heartbeat-sec",
        "0",
        "--window-title",
        "Vision Server (RoboMaster Fake API)"
      ]
    },
    {
      "name": "HW | Vision Server (Pycar TCP)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "args": [
        "--host",
        "${input:serverHost}",
        "--port",
        "${input:serverPort}",
        "--camera",
        "${input:cameraIndex}",
        "--marker-id",
        "${input:markerId}",
        "--mode",
        "${input:hwMode}",
        "--window-title",
        "Vision Server (Pycar TCP)"
      ]
    },
    {
      "name": "HW | Vision Server (Arduino TCP)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "args": [
        "--host",
        "${input:serverHost}",
        "--port",
        "${input:serverPort}",
        "--camera",
        "${input:cameraIndex}",
        "--marker-id",
        "${input:markerId}",
        "--mode",
        "${input:arduinoMode}",
        "--window-title",
        "Vision Server (Arduino TCP)"
      ]
    },
    {
      "name": "HW | Vision Server (RoboMaster API)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "python": "${workspaceFolder}/.venv-robomaster38/Scripts/python.exe",
      "console": "integratedTerminal",
      "args": [
        "--transport",
        "robomaster",
        "--camera",
        "${input:cameraIndex}",
        "--marker-id",
        "${input:markerId}",
        "--mode",
        "${input:robomasterMode}",
        "--robomaster-ip",
        "${input:robomasterIp}",
        "--robomaster-speed",
        "${input:robomasterSpeed}",
        "--window-title",
        "Vision Server (RoboMaster API)"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Sim | Full Stack (Server + Visual Client)",
      "configurations": [
        "Sim | Vision Server",
        "Sim | Visual Rover Client"
      ]
    }
  ],
  "inputs": [
    {
      "id": "serverHost",
      "type": "promptString",
      "description": "Server bind host",
      "default": "0.0.0.0"
    },
    {
      "id": "clientHost",
      "type": "promptString",
      "description": "Host/IP del server visto dal client",
      "default": "127.0.0.1"
    },
    {
      "id": "serverPort",
      "type": "promptString",
      "description": "Porta TCP server",
      "default": "9999"
    },
    {
      "id": "cameraIndex",
      "type": "promptString",
      "description": "Indice webcam",
      "default": "0"
    },
    {
      "id": "markerId",
      "type": "promptString",
      "description": "ID marker ArUco",
      "default": "0"
    },
    {
      "id": "simMode",
      "type": "pickString",
      "description": "Modalita server per simulazione",
      "options": [
        "chase",
        "dpad"
      ],
      "default": "dpad"
    },
    {
      "id": "hwMode",
      "type": "pickString",
      "description": "Modalita server per hardware reale",
      "options": [
        "chase",
        "dpad"
      ],
      "default": "dpad"
    },
    {
      "id": "arduinoMode",
      "type": "pickString",
      "description": "Modalita server per rover Arduino TCP",
      "options": [
        "dpad",
        "chase"
      ],
      "default": "dpad"
    },
    {
      "id": "robomasterMode",
      "type": "pickString",
      "description": "Modalita server per RoboMaster API",
      "options": [
        "dpad",
        "chase"
      ],
      "default": "dpad"
    },
    {
      "id": "robomasterIp",
      "type": "promptString",
      "description": "IP del RoboMaster",
      "default": "192.168.1.101"
    },
    {
      "id": "robomasterSpeed",
      "type": "promptString",
      "description": "Velocita RoboMaster (es. 0.5)",
      "default": "0.5"
    }
  ]
}
